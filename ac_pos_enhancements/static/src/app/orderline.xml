<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="ac_pos_enhancements.Orderline"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">

        <!-- Line index (1, 2, 3, …) — inserted as a sibling BEFORE the qty span -->
        <xpath expr="//span[hasclass('qty')]" position="before">
            <span t-if="vals.lineIndex" class="ac-line-index fw-bolder px-1 text-muted">
                <t t-esc="vals.lineIndex"/>.
            </span>
        </xpath>

        <!-- Show original catalog price when price was manually changed -->
        <xpath expr="//ul[hasclass('info-list')]" position="inside">
            <li t-if="vals.isPriceModified" class="ac-original-price text-warning">
                <i class="fa fa-info-circle me-1"/>
                <em>Original:</em>
                <strong><t t-esc="vals.originalUnitPrice"/></strong>
                <span class="ms-1">(adjusted by <t t-esc="vals.priceDelta"/>)</span>
            </li>
        </xpath>

    </t>

</templates>
