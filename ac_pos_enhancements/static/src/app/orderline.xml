<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="ac_pos_enhancements.Orderline"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">

        <!-- Prepend line index (1, 2, 3, …) before the product name -->
        <xpath expr="//span[hasclass('text-wrap')]/t[1]" position="before">
            <span t-if="vals.lineIndex" class="line-index fw-bolder me-1 text-muted">
                <t t-esc="vals.lineIndex"/>.
            </span>
        </xpath>

        <!-- Show the original catalog price when the cashier has manually changed the price -->
        <xpath expr="//ul[hasclass('info-list')]" position="inside">
            <li t-if="vals.isPriceModified" class="original-price-line text-warning">
                <i class="fa fa-info-circle me-1"/>
                <em>Original:</em>
                <strong><t t-esc="vals.originalUnitPrice"/></strong>
                <span class="ms-1">(adjusted by <t t-esc="vals.priceDelta"/>)</span>
            </li>
        </xpath>

    </t>

</templates>
